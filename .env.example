# Set to true to run the frontend as standalone demo pages (no Laravel API).
VITE_DEMO_MODE=true

VITE_API_URL=http://localhost:8000/api

# Public site origin (no trailing slash). Required for absolute Open Graph image URLs when sharing your domain.
# Example: https://app.ihtechno.demo
VITE_SITE_URL=

VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Cloudflare Turnstile (login CAPTCHA). Use dummy key locally: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
